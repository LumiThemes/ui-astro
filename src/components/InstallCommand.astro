---
/**
 * InstallCommand: one copyable command bar whose button opens a menu of
 * ways to get the thing — a package manager, a CLI, a prompt to hand an
 * agent — grouped under titles. Choosing one swaps the bar's label and
 * icon, the command shown, what the copy button copies and the note under
 * the bar; plain links (downloads, a page with every way) can sit at the
 * foot of the menu. Arrow keys, Home and End move through the menu, Escape
 * and a click outside close it, and a copy shows a tick for a moment. See
 * src/runtime/install-command.js.
 *
 * @example
 * <InstallCommand groups={[{ title: 'Install', options: [{ label: 'npm', prefix: '$ ', command: 'npm i my-lib' }, { label: 'pnpm', prefix: '$ ', command: 'pnpm add my-lib' }] }]} />
 */

interface Option {
	/** Names it (`data-selected` on the root); the label, slugged, if not given. */
	id?: string;
	/** Its name, on the button and in the menu. */
	label: string;
	/** An icon: trusted SVG markup, about 16px. */
	icon?: string;
	/** Shown before the command but not copied (`$ `). */
	prefix?: string;
	/** The command shown in the bar. */
	command: string;
	/** What the copy button copies, if not the command (several lines, say). */
	copy?: string;
	/** A line under the bar: trusted HTML. */
	note?: string;
	/** A small tag at the end of its menu row (`Prompt`). */
	tag?: string;
}

interface Group {
	/** The heading over the group. */
	title?: string;
	/** Its options. */
	options: Option[];
}

interface Link {
	/** The link's text. */
	label: string;
	/** Where it goes. */
	href: string;
	/** An icon: trusted SVG markup; a download arrow for a download. */
	icon?: string;
	/** A small tag at the end of the row (`.zip`). */
	tag?: string;
	/** Download it (`true`, or the file name). */
	download?: boolean | string;
}

interface Props {
	/** The options, in titled groups (`{ title, options: [{ id, label, icon, prefix, command, copy, note, tag }] }`). The first option shows at first. Required. */
	groups: Group[];
	/** Plain links at the foot of the menu (`{ label, href, icon, tag, download }`). Default none. */
	links?: Link[];
	/** The heading over the links. Default `Download`; empty for none. */
	linksTitle?: string;
	/** The option to show at first, by id. Default the first. */
	selected?: string;
	/** Line the bar and its note up at the start or the centre. Default `start`. */
	align?: 'start' | 'center';
	/** The copy button's name for screen readers. Default `Copy the command`. */
	copyLabel?: string;
	/** Classes for the element. */
	class?: string;
}

const { groups, links = [], linksTitle = 'Download', selected, align = 'start', copyLabel = 'Copy the command', class: className } = Astro.props;
const uid = `ui-install-${Math.random().toString(36).slice(2, 8)}`;
/** A label as an id. */
const slug = (s: string) =>
	s
		.toLowerCase()
		.replace(/[^a-z\d]+/g, '-')
		.replace(/^-|-$/g, '');
const all = groups.flatMap((g) => g.options.map((o) => ({ ...o, id: o.id ?? slug(o.label) })));
const first = all.find((o) => o.id === selected) ?? all[0];
const icons = {
	chevron: '<path d="m6 9 6 6 6-6"/>',
	copy: '<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/>',
	check: '<path d="M20 6 9 17l-5-5"/>',
	download: '<path d="M12 3v12m-5-5 5 5 5-5M5 21h14"/>',
};
/** A line icon from its paths, hidden from screen readers. */
const svg = (paths: string, size = 16) =>
	`<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
---

<div class:list={['ui-install', align === 'center' && 'is-center', className]} data-ui-install-command data-selected={first?.id}>
	<div class="ui-install-bar">
		<button type="button" class="ui-install-trigger" data-ui-install="trigger" aria-haspopup="menu" aria-expanded="false" aria-controls={`${uid}-menu`}>
			<span class="ui-install-current" data-ui-install="icon" aria-hidden="true" set:html={first?.icon ?? ''} />
			<span data-ui-install="label">{first?.label}</span>
			<span class="ui-install-chev" set:html={svg(icons.chevron, 14)} />
		</button>
		<code class="ui-install-code"><span class="ui-install-prefix" data-ui-install="prefix">{first?.prefix ?? ''}</span><span data-ui-install="text">{first?.command}</span></code>
		<button type="button" class="ui-install-copy" data-ui-install="copy" data-copy={first?.copy ?? first?.command} aria-label={copyLabel}>
			<span class="ui-install-copy-icon" set:html={svg(icons.copy, 17)} />
			<span class="ui-install-done-icon" set:html={svg(icons.check, 17)} />
		</button>

		<div class="ui-install-menu" id={`${uid}-menu`} data-ui-install="menu" role="menu" aria-label="Choose how" hidden>
			{
				groups.map((g, gi) => (
					<>
						{gi > 0 && <hr />}
						<div role="group" aria-labelledby={g.title ? `${uid}-g${gi}` : undefined}>
							{g.title && (
								<p class="ui-install-group" id={`${uid}-g${gi}`}>
									{g.title}
								</p>
							)}
							{g.options.map((o) => {
								const id = o.id ?? slug(o.label);
								return (
									<button
										type="button"
										class="ui-install-item"
										role="menuitemradio"
										aria-checked={id === first?.id ? 'true' : 'false'}
										tabindex="-1"
										data-id={id}
										data-label={o.label}
										data-prefix={o.prefix ?? ''}
										data-command={o.command}
										data-copy={o.copy ?? o.command}
										data-note={o.note ?? ''}
									>
										<span class="ui-install-icon" aria-hidden="true" set:html={o.icon ?? ''} />
										{o.label}
										{o.tag && <span class="ui-install-tag">{o.tag}</span>}
									</button>
								);
							})}
						</div>
					</>
				))
			}
			{
				links.length > 0 && (
					<>
						<hr />
						<div role="group" aria-labelledby={linksTitle ? `${uid}-links` : undefined}>
							{linksTitle && (
								<p class="ui-install-group" id={`${uid}-links`}>
									{linksTitle}
								</p>
							)}
							{links.map((l) => (
								<a class="ui-install-item" role="menuitem" tabindex="-1" href={l.href} download={l.download === true ? '' : l.download || undefined}>
									<span class="ui-install-icon" aria-hidden="true" set:html={l.icon ?? (l.download ? svg(icons.download) : '')} />
									{l.label}
									{l.tag && <span class="ui-install-tag">{l.tag}</span>}
								</a>
							))}
						</div>
					</>
				)
			}
		</div>
	</div>
	<p class="ui-install-note" data-ui-install="note" hidden={!first?.note} set:html={first?.note ?? ''} />
	<span class="ui-install-sr" data-ui-install="status" role="status"></span>
</div>

<script>
	import { mount } from '../runtime/mount.js';
	import { installCommand } from '../runtime/install-command.js';

	mount('[data-ui-install-command]', installCommand);
</script>

<style>
	.ui-install {
		--ui-install-line: color-mix(in srgb, currentColor 14%, transparent);
		--ui-install-muted: color-mix(in srgb, currentColor 60%, transparent);
		display: grid;
		gap: 0.6rem;
		justify-items: start;
		min-width: 0;
		max-width: 100%;
	}

	.ui-install.is-center {
		justify-items: center;
	}

	.ui-install-bar {
		position: relative;
		display: inline-flex;
		align-items: stretch;
		min-width: 0;
		max-width: 100%;
		height: var(--ui-install-h, 46px);
		border: 1px solid var(--ui-install-border, var(--ui-install-line));
		border-radius: var(--ui-install-radius, 999px);
		background: var(--ui-install-bg, color-mix(in srgb, currentColor 4%, transparent));
	}

	.ui-install-trigger {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		gap: 0.45rem;
		padding: 0 0.8rem 0 1rem;
		border: 0;
		border-right: 1px solid var(--ui-install-border, var(--ui-install-line));
		border-radius: var(--ui-install-radius, 999px) 0 0 var(--ui-install-radius, 999px);
		background: none;
		color: inherit;
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.15s;
	}

	.ui-install-trigger:hover,
	.ui-install-trigger[aria-expanded='true'] {
		background: color-mix(in srgb, currentColor 6%, transparent);
	}

	.ui-install-trigger:focus-visible,
	.ui-install-copy:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: -4px;
	}

	.ui-install-current,
	.ui-install-icon {
		display: grid;
		place-items: center;
		color: var(--ui-install-muted);
	}

	.ui-install-current:empty,
	.ui-install-icon:empty {
		display: none;
	}

	.ui-install :global(svg) {
		display: block;
		flex-shrink: 0;
	}

	.ui-install-chev {
		display: grid;
		color: var(--ui-install-muted);
		transition: transform 0.2s ease;
	}

	.ui-install-trigger[aria-expanded='true'] .ui-install-chev {
		transform: rotate(180deg);
	}

	.ui-install-code {
		overflow: hidden;
		flex: 1;
		align-self: center;
		min-width: 0;
		padding: 0 0.9rem;
		background: none;
		font-family: var(--ui-install-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
		font-size: 0.85rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.ui-install-prefix {
		color: var(--ui-install-muted);
		user-select: none;
	}

	.ui-install-copy {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		padding: 0 1rem 0 0.4rem;
		border: 0;
		border-radius: 0 var(--ui-install-radius, 999px) var(--ui-install-radius, 999px) 0;
		background: none;
		color: var(--ui-install-muted);
		cursor: pointer;
	}

	.ui-install-copy:hover {
		color: inherit;
	}

	.ui-install-copy > span {
		display: grid;
		grid-area: 1 / 1;
		transition: opacity 0.15s;
	}

	.ui-install-done-icon,
	.ui-install-copy.is-done .ui-install-copy-icon {
		opacity: 0;
	}

	.ui-install-copy.is-done .ui-install-done-icon {
		opacity: 1;
		color: var(--ui-install-done, #22c55e);
	}

	.ui-install-menu {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 0;
		z-index: 30;
		width: 16rem;
		max-width: calc(100vw - 2rem);
		padding: 0.35rem;
		border: 1px solid var(--ui-menu-border, color-mix(in srgb, var(--ui-menu-fg, CanvasText) 14%, transparent));
		border-radius: 14px;
		background: var(--ui-menu-bg, Canvas);
		color: var(--ui-menu-fg, CanvasText);
		box-shadow: 0 20px 50px rgb(0 0 0 / 0.25);
		text-align: left;
	}

	.ui-install-menu[hidden] {
		display: none;
	}

	.ui-install-group {
		margin: 0;
		padding: 0.45rem 0.6rem 0.25rem;
		color: color-mix(in srgb, currentColor 60%, transparent);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.ui-install-menu hr {
		margin: 0.35rem 0.3rem;
		border: 0;
		border-top: 1px solid color-mix(in srgb, currentColor 14%, transparent);
	}

	.ui-install-item {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		box-sizing: border-box;
		width: 100%;
		padding: 0.5rem 0.6rem;
		border: 0;
		border-radius: 9px;
		background: none;
		color: inherit;
		font: inherit;
		font-size: 0.86rem;
		line-height: 1.3;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
	}

	.ui-install-menu .ui-install-icon {
		color: color-mix(in srgb, currentColor 60%, transparent);
	}

	.ui-install-item:hover,
	.ui-install-item:focus-visible,
	.ui-install-item[aria-checked='true'] {
		outline: none;
		background: color-mix(in srgb, currentColor 8%, transparent);
	}

	.ui-install-tag {
		margin-left: auto;
		color: color-mix(in srgb, currentColor 60%, transparent);
		font-size: 0.7rem;
	}

	.ui-install-note {
		margin: 0;
		padding-left: 1rem;
		color: var(--ui-install-muted);
		font-size: 0.8rem;
	}

	.ui-install-note[hidden] {
		display: none;
	}

	.ui-install.is-center .ui-install-note {
		padding: 0;
		text-align: center;
	}

	.ui-install-note :global(a) {
		color: inherit;
		text-underline-offset: 3px;
	}

	.ui-install-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (max-width: 520px) {
		/* an icon alone names the option on a narrow screen */
		.ui-install-current:not(:empty) + [data-ui-install='label'] {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		.ui-install-trigger {
			padding-left: 0.85rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ui-install-trigger,
		.ui-install-chev,
		.ui-install-copy > span {
			transition: none;
		}
	}
</style>
